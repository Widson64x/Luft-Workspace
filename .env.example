# ==========================================================
# Luft-Workspace — configuração (modelo) (LuftBase)
# Bancos, sessão, e-mail e LDAP são resolvidos pelo LuftBase via Vault:
#   luft/<ambiente>/bancos/postgresql/sistemas/0   (schema do sistema)
#   luft/<ambiente>/integracoes/email
#
# Padrão Luft: todos os sistemas usam este esqueleto, na mesma ordem.
# O que é comum vem primeiro; o que é particular do sistema, no fim.
# ==========================================================

# --- Identidade ---
# O ID numérico é a única identidade de bootstrap: nome e metadados vêm de core.tb_sistema.
LUFT_SISTEMA_ID=0
# desenvolvimento | homologacao | producao
LUFT_AMBIENTE=desenvolvimento
# A versão vem de App/_version.py; só preencha para forçá-la (ex.: scripts fora da aplicação).
LUFT_APLICACAO_VERSAO=

# --- Vault ---
LUFT_VAULT_ENDERECO=http://172.16.200.80:8200
LUFT_VAULT_NAMESPACE=luft
LUFT_VAULT_TOKEN=<TOKEN_VAULT_CRIPTOGRAFADO>
LUFT_TOKEN_ACESSO=<TOKEN_ACESSO>

# --- LDAP corporativo (credenciais de usuário nunca ficam no ambiente) ---
LUFT_LDAP_SERVIDOR=luftfarma.com.br
LUFT_LDAP_DOMINIO=luftfarma
LUFT_LDAP_TRANSPORTE=ldaps
LUFT_LDAP_TIMEOUT_SEGUNDOS=5

# --- Sessão compartilhada entre os sistemas (SSO): iguais em todos do mesmo ambiente ---
LUFT_SESSAO_COOKIE_NOME=luft_sessao
LUFT_SESSAO_COOKIE_CAMINHO=/
LUFT_SESSAO_COOKIE_DOMINIO=
LUFT_SESSAO_COOKIE_SAMESITE=Lax
LUFT_SESSAO_COOKIE_SEGURO=false
# Producao exige cookie Secure (HTTPS). Em rede interna servida por HTTP, true libera o login.
LUFT_PERMITIR_COOKIE_INSEGURO=false
# Minutos sem atividade até a sessão expirar
LUFT_SESSAO_TTL_MINUTOS=30

# --- Autorização (opcional; valores padrão do LuftBase) ---
# LUFT_AUTORIZACAO_TTL_SEGUNDOS=300
# LUFT_AUTORIZACAO_REVISAO_TTL_SEGUNDOS=5
# LUFT_AUTORIZACAO_MAX_CHAVES=100

# --- Processo HTTP (Wsgi.py publica no ROUTE_PREFIX; App.py responde na raiz) ---
HOST=127.0.0.1
PORT=9010
ROUTE_PREFIX=

# ==========================================================
# Particularidades do Luft-Workspace
# ==========================================================
# Mostra o SQL emitido pelo SQLAlchemy (diagnóstico)
DB_CONNECT_LOGS=false

# Operações de serviço do Workspace (nomes dos serviços do Windows; não pertencem ao LuftBase).
# Nomes no formato systemd (.service) são convertidos sozinhos para o nome do serviço do Windows.
LUFT_WORKSPACE_SERVICE_NAME=
LUFT_CONTROL_SERVICE_NAME=
LUFT_CONNECTAIR_SERVICE_NAME=
LUFT_INTEGRADOR_SERVICE_NAME=
LUFT_DOCS_WEB_SERVICE_NAME=
LUFT_DOCS_API_SERVICE_NAME=
NGINX_SERVICE_NAME=

# Descoberta dinâmica de projetos (.env/.venv)
OPERACOES_SCAN_ROOTS=
WORKSPACE_PROJECT_DIR=
LUFT_CONTROL_PROJECT_DIR=
LUFT_CONNECTAIR_PROJECT_DIR=
LUFT_DOCS_PROJECT_DIR=
LUFT_INTEGRADOR_PROJECT_DIR=

# Integração Oracle opcional (particular do Workspace)
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_DSN=
